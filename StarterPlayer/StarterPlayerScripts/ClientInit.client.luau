--!strict
-- Main client bootstrapper for Dig Pals (MoundVisuals, HudController, InventoryController, MerchantController, ShovelShopController, BaseController, & DigController)

local Controllers = script.Parent:WaitForChild("Controllers")
local MoundVisuals = require(Controllers:WaitForChild("MoundVisuals"))
local HudController = require(Controllers:WaitForChild("HudController"))
local InventoryController = require(Controllers:WaitForChild("InventoryController"))
local MerchantController = require(Controllers:WaitForChild("MerchantController"))
local ShovelShopController = require(Controllers:WaitForChild("ShovelShopController"))
local BaseController = require(Controllers:WaitForChild("BaseController"))
local PetBagController = require(Controllers:WaitForChild("PetBagController"))
local PetVisualController = require(Controllers:WaitForChild("PetVisualController"))
local OfflineIncomeController = require(Controllers:WaitForChild("OfflineIncomeController"))
local SharedMoundController = require(Controllers:WaitForChild("SharedMoundController"))
local DigController = require(Controllers:WaitForChild("DigController"))

MoundVisuals.Start()
HudController.Start()
InventoryController.Start()
MerchantController.Start()
ShovelShopController.Start()
BaseController.Start()
PetBagController.Start()
PetVisualController.Start()
OfflineIncomeController.Start()
SharedMoundController.Start()
DigController.Start()
