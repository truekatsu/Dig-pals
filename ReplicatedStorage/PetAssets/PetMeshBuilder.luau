local petData = HttpService:JSONDecode(rawJson)

function PetMeshBuilder.CreateMesh(species: string): MeshPart?
	local d = petData[species]
	if not d then return nil end

	local em = AssetService:CreateEditableMesh()

	local vertIds = table.create(#d.verts)
	for i, v in ipairs(d.verts) do
		vertIds[i] = em:AddVertex(Vector3.new(v[1], v[2], v[3]))
	end

	local colorIds = table.create(#d.colors)
	for i, c in ipairs(d.colors) do
		colorIds[i] = em:AddColor(Color3.fromRGB(c[1], c[2], c[3]), 1)
	end

	for _, tri in ipairs(d.tris) do
		local v1 = vertIds[tri[1]]
		local v2 = vertIds[tri[2]]
		local v3 = vertIds[tri[3]]
		if v1 and v2 and v3 then
			local f = em:AddTriangle(v1, v2, v3)
			local cId = colorIds[tri[4] + 1]
			if f and cId then
				em:SetFaceColors(f, { cId, cId, cId })
			end
		end
	end

	local meshPart = AssetService:CreateMeshPartAsync(Content.fromObject(em))
	meshPart.Name = species .. "_Mesh"
	meshPart.Material = Enum.Material.SmoothPlastic
	meshPart.CanCollide = false
	meshPart.CanTouch = false
	meshPart.CanQuery = false
	meshPart.CastShadow = true
	meshPart.Anchored = false
	meshPart.Massless = true
	return meshPart
end

return PetMeshBuilder
